#!/usr/bin/env bash
# Load secrets into Claude Code session via CLAUDE_ENV_FILE
# Triggered by SessionStart hook
#
# No set -e: a single bad line must not abort the entire hook.
# Errors are reported to stderr so the user sees them in hook output.

ENV_FILE="$CLAUDE_PROJECT_DIR/{{ENV_FILE_PATH}}"

if [ ! -f "$ENV_FILE" ]; then
  exit 0  # No env file yet — skip silently
fi

if [ -z "${CLAUDE_ENV_FILE:-}" ]; then
  exit 0  # No CLAUDE_ENV_FILE provided — skip
fi

lineno=0
while IFS= read -r line || [ -n "$line" ]; do
  lineno=$((lineno + 1))

  # Strip carriage return (CRLF safety)
  line="${line%$'\r'}"

  # Skip comments and empty lines
  [[ "$line" =~ ^[[:space:]]*# ]] && continue
  [[ -z "${line// }" ]] && continue

  # Strip leading 'export ' if present
  line="${line#export }"

  # Skip malformed lines without '='
  if [[ "$line" != *=* ]]; then
    echo "load-secrets: skipping line $lineno (no '='): $line" >&2
    continue
  fi

  key="${line%%=*}"
  value="${line#*=}"

  # Trim whitespace from key
  key="${key#"${key%%[![:space:]]*}"}"
  key="${key%"${key##*[![:space:]]}"}"

  # Skip empty or invalid variable names (must be [A-Za-z_][A-Za-z0-9_]*)
  if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    echo "load-secrets: skipping line $lineno (invalid key): $key" >&2
    continue
  fi

  # Strip surrounding quotes from value (double or single)
  if [[ "$value" =~ ^\"(.*)\"$ ]]; then
    value="${BASH_REMATCH[1]}"
  elif [[ "$value" =~ ^\'(.*)\'$ ]]; then
    value="${BASH_REMATCH[1]}"
  fi

  # Single-quote output prevents shell expansion ($, `, \, !)
  # Escape embedded single quotes: ' → '\''  (end-quote, escaped-quote, re-open-quote)
  escaped=$(printf '%s' "$value" | sed "s/'/'\\\\''/g")
  printf "export %s='%s'\n" "$key" "$escaped" >> "$CLAUDE_ENV_FILE"
done < "$ENV_FILE"

exit 0
