{
  "description": "Data path resolution and lazy init",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/setup-data.sh"
          }
        ]
      }
    ]
  }
}
