{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/post-pr.sh",
            "if": "Bash(gh pr create)",
            "statusMessage": "duck: checking for PR creation..."
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/post-pr.sh",
            "if": "Bash(gh pr create *)",
            "statusMessage": "duck: checking for PR creation..."
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/post-pr.sh",
            "if": "Bash(glab mr create)",
            "statusMessage": "duck: checking for MR creation..."
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/post-pr.sh",
            "if": "Bash(glab mr create *)",
            "statusMessage": "duck: checking for MR creation..."
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/post-push.sh",
            "if": "Bash(git push)",
            "statusMessage": "duck: checking for git push..."
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/post-push.sh",
            "if": "Bash(git push *)",
            "statusMessage": "duck: checking for git push..."
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/post-plan.sh",
            "statusMessage": "duck: plan detected, considering review offer..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/post-write-plan.sh",
            "statusMessage": "duck: checking if written file is a plan/spec..."
          }
        ]
      }
    ]
  }
}
